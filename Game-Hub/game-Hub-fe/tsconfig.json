{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "paths": {
      "@spartan/button": [
        "./libs/ui/button/src/index.ts"
      ],
      "@spartan/utils": [
        "./libs/ui/utils/src/index.ts"
      ],
      "@spartan/dropdown-menu": [
        "./libs/ui/dropdown-menu/src/index.ts"
      ],
      "@spartan/checkbox": [
        "./libs/ui/checkbox/src/index.ts"
      ],
      "@spartan/dialog": [
        "./libs/ui/dialog/src/index.ts"
      ],
      "@spartan/textarea": [
        "./libs/ui/textarea/src/index.ts"
      ],
      "@spartan/tabs": [
        "./libs/ui/tabs/src/index.ts"
      ],
      "@spartan/label": [
        "./libs/ui/label/src/index.ts"
      ],
      "@spartan/input": [
        "./libs/ui/input/src/index.ts"
      ],
      "@spartan/card": [
        "./libs/ui/card/src/index.ts"
      ],
      "@spartan/spinner": [
        "./libs/ui/spinner/src/index.ts"
      ],
      "@spartan/field": [
        "./libs/ui/field/src/index.ts"
      ],
      "@spartan/separator": [
        "./libs/ui/separator/src/index.ts"
      ],
      "@spartan/sidebar": [
        "./libs/ui/sidebar/src/index.ts"
      ],
      "@spartan/sheet": [
        "./libs/ui/sheet/src/index.ts"
      ],
      "@spartan/skeleton": [
        "./libs/ui/skeleton/src/index.ts"
      ],
      "@spartan/tooltip": [
        "./libs/ui/tooltip/src/index.ts"
      ],
      "@spartan/input-group": [
        "./libs/ui/input-group/src/index.ts"
      ],
      "@spartan/switch": [
        "./libs/ui/switch/src/index.ts"
      ]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
